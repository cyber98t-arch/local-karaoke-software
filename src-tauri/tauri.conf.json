{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hibiki Local Karaoke",
  "version": "0.1.0",
  "identifier": "jp.hibiki.karaoke",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Hibiki Local Karaoke", "width": 1280, "height": 800, "minWidth": 1000, "minHeight": 680 }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all" }
}

